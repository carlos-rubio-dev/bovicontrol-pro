# Copia este archivo como .env. Sin DATABASE_URL se usa SQLite local.
# Crea primero la base: CREATE DATABASE bovicontrol CHARACTER SET utf8mb4;
# Codifica los caracteres especiales de la contraseña como URL.
# DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/bovicontrol?charset=utf8mb4
# Para TiDB Cloud Starter: mysql+pymysql://usuario:password@host:4000/test?ssl_verify_cert=true&ssl_verify_identity=true
SECRET_KEY=cambia-esta-clave-por-una-cadena-aleatoria-larga
