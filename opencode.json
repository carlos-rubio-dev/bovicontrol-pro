{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "default_agent": "coordinador",
  "instructions": [
    "docs/desarrollo.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "instance/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "question": "deny"
  }
}
